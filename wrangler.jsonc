{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chamelo",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "routes": [{ "pattern": "chamelo.hexly.ai", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
